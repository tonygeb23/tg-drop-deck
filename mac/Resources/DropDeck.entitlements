<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed. The app references sound files where they sit, all over
	     the user's drives, and never copies them. A sandbox would break every
	     board on the first launch after an update. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The hardened runtime blocks loading unsigned Audio Units into the
	     process. Tony's plugin folder is full of them, so hosting a plugin
	     needs this. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
